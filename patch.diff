+                GameObject StairCaseInstance = Instantiate(StairCasePrefab);
+                StairCaseInstance.transform.position = RealRoomPosition;
+            }
+            else
+            {
+                GameObject RoomInstance = Instantiate(RoomPrefab);
+                RoomInstance.transform.position = RealRoomPosition;
+            }
         }   
     }
+
+    private Vector3 RoomPosToRealPos(Vector3 p)
+    {
+        return p * 10;
+    }
 }
